# ============================================================
# PeopleBook / Birdy — Environment Variables
# Copy to .env.local for local dev. Set in Railway for production.
# NEVER commit actual values. This file is safe to commit.
# ============================================================

# ── Database ──────────────────────────────────────────────────────────────────
# Railway: use the DATABASE_URL from the Railway Postgres plugin
# Prisma pool params are appended automatically in lib/prisma.ts
DATABASE_URL="postgresql://user:password@localhost:5432/peoplebook"

# ── Airtable ──────────────────────────────────────────────────────────────────
AIRTABLE_API_KEY="your_airtable_api_key"
AIRTABLE_BASE_ID="appGGFKuFxQ3Z0Wuz"
AIRTABLE_ROLES_TABLE="tblH6wo8yXqUYdKRi"
AIRTABLE_APPLICANTS_TABLE="tblCQ9I8odPZRKKfv"
AIRTABLE_SKILLS_TABLE="tbl7d1TD4Hi1ZoP6P"

# Optional: protect the cache-invalidation webhook endpoint
# AIRTABLE_WEBHOOK_SECRET="generate-a-random-secret-here"

# ── NextAuth ──────────────────────────────────────────────────────────────────
NEXTAUTH_SECRET="generate-a-random-secret-here"
NEXTAUTH_URL="https://your-railway-url.railway.app"
NEXT_PUBLIC_APP_URL="https://your-railway-url.railway.app"

# ── Birdy AI Providers ────────────────────────────────────────────────────────
# Anthropic Claude — REQUIRED for Birdy to work
# Get yours at: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY="sk-ant-api03-..."

# Ollama — OPTIONAL: enables phi4, deepseek-coder, qwen3 models
# Set to your Railway Ollama service internal URL (private networking)
# Leave unset to use Claude for all requests (safe default)
# OLLAMA_BASE_URL="http://ollama.railway.internal:11434"

# ── File Uploads (UploadThing) ────────────────────────────────────────────────
# Get yours at: https://uploadthing.com/dashboard
UPLOADTHING_SECRET="sk_live_..."
UPLOADTHING_APP_ID="your-app-id"

# ── Email (Resend) ────────────────────────────────────────────────────────────
RESEND_API_KEY="re_..."

# ── nginx service (Railway only) ─────────────────────────────────────────────
# Set in the nginx Railway service environment, NOT in the web service:
# NEXTJS_UPSTREAM="web.railway.internal:3000"

# ── Railway meta ──────────────────────────────────────────────────────────────
RAILWAY_PROJECT_ID="d322220a-9e04-4644-9a0c-e6f0429dc859"

# ── Phase 3: Memory & RAG ─────────────────────────────────────────────────────
# Ollama must be running with nomic-embed-text pulled for RAG/embeddings.
# Railway: set OLLAMA_BASE_URL to your Ollama service's internal URL.
# Without Ollama: documents are stored + full-text searchable (no vector search).
# OLLAMA_BASE_URL=http://ollama.railway.internal:11434

# pgvector is enabled automatically via the health check endpoint on first startup.
# Requires Railway Postgres (supports pgvector natively).
# No extra config needed — ensureVectorSetup() handles CREATE EXTENSION.
