generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Existing portal models (unchanged) ────────────────────────────────────

model Role {
  id             String          @id @default(cuid())
  airtableId     String?         @unique
  title          String
  department     String
  status         RoleStatus      @default(OPEN)
  priority       Priority        @default(MEDIUM)
  employmentType String?
  dateOpened     DateTime?
  dateFilled     DateTime?
  notes          String?
  shift          String?
  hours          String?
  openings       Int             @default(1)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  applicants     ApplicantRole[]
  @@map("roles")
}

model Applicant {
  id                String           @id @default(cuid())
  airtableId        String?          @unique
  fullName          String
  email             String?
  phone             String?
  stage             Stage            @default(NEW)
  cityLocation      String?
  linkedinUrl       String?
  availabilityDate  DateTime?
  salaryExpectation Float?
  source            String?
  yearsExperience   Int?
  highestEducation  String?
  workAuthorization String?
  shiftPreference   String?
  referredBy        String?
  internalRating    String?
  interviewScore    Int?
  applicationScore  Int?
  offerExtended     Boolean          @default(false)
  offerAccepted     Boolean          @default(false)
  doNotContact      Boolean          @default(false)
  interviewDate     DateTime?
  lastContacted     DateTime?
  dateApplied       DateTime?
  notes             String?
  q1 String? q2 String? q3 String? q4 String? q5 String?
  q6 String? q7 String? q8 String? q9 String? q10 String?
  q11 String? q12 String? q13 String? q14 String? q15 String?
  resumeUrl         String?
  resumeName        String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  roles             ApplicantRole[]
  skills            ApplicantSkill[]
  @@map("applicants")
}

model ApplicantRole {
  applicantId String
  roleId      String
  type        RoleLinkType @default(APPLIED)
  applicant   Applicant    @relation(fields: [applicantId], references: [id], onDelete: Cascade)
  role        Role         @relation(fields: [roleId], references: [id], onDelete: Cascade)
  @@id([applicantId, roleId, type])
  @@map("applicant_roles")
}

model Skill {
  id         String           @id @default(cuid())
  airtableId String?          @unique
  name       String           @unique
  category   String?
  notes      String?
  createdAt  DateTime         @default(now())
  applicants ApplicantSkill[]
  @@map("skills")
}

model ApplicantSkill {
  applicantId String
  skillId     String
  applicant   Applicant @relation(fields: [applicantId], references: [id], onDelete: Cascade)
  skill       Skill     @relation(fields: [skillId], references: [id], onDelete: Cascade)
  @@id([applicantId, skillId])
  @@map("applicant_skills")
}

// ── Birdy core ─────────────────────────────────────────────────────────────

model BirdyConversation {
  id        String                @id @default(cuid())
  sessionId String
  title     String?
  module    String?
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt
  messages  BirdyMessage[]
  summaries BirdyMemorySummary[]
  @@index([sessionId, updatedAt(sort: Desc)])
  @@map("birdy_conversations")
}

model BirdyMessage {
  id             String            @id @default(cuid())
  conversationId String
  role           BirdyRole
  content        String
  modelUsed      String?
  provider       String?
  tokensIn       Int               @default(0)
  tokensOut      Int               @default(0)
  latencyMs      Int?
  actionKey      String?
  citations      Json?             // Array of {chunkId, documentName, score}
  createdAt      DateTime          @default(now())
  conversation   BirdyConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  @@index([conversationId, createdAt(sort: Asc)])
  @@map("birdy_messages")
}

// ── Birdy observability ────────────────────────────────────────────────────

model BirdyUsageLog {
  id             String   @id @default(cuid())
  sessionId      String
  conversationId String?
  provider       String
  model          String
  intent         String?
  tokensIn       Int      @default(0)
  tokensOut      Int      @default(0)
  latencyMs      Int?
  ragChunksUsed  Int?     // how many RAG chunks were injected
  ragLatencyMs   Int?     // how long retrieval took
  status         String   @default("success")
  errorMessage   String?
  pageModule     String?
  actionKey      String?
  createdAt      DateTime @default(now())
  @@index([sessionId, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
  @@map("birdy_usage_logs")
}

// ── Birdy knowledge base ───────────────────────────────────────────────────

model BirdyDocument {
  id          String               @id @default(cuid())
  sessionId   String
  name        String
  mimeType    String
  sizeBytes   Int?
  storageUrl  String
  status      DocumentStatus       @default(PENDING)
  chunkCount  Int                  @default(0)
  wordCount   Int?
  errorMsg    String?
  namespace   String               @default("default")
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  chunks      BirdyDocumentChunk[]
  embeddings  BirdyEmbedding[]
  @@index([sessionId, createdAt(sort: Desc)])
  @@map("birdy_documents")
}

model BirdyDocumentChunk {
  id          String         @id @default(cuid())
  documentId  String
  chunkIndex  Int
  content     String
  tokenCount  Int?
  startChar   Int?
  endChar     Int?
  createdAt   DateTime       @default(now())
  document    BirdyDocument  @relation(fields: [documentId], references: [id], onDelete: Cascade)
  embedding   BirdyEmbedding?
  @@index([documentId, chunkIndex])
  @@map("birdy_document_chunks")
}

// BirdyEmbedding stores metadata for each embedded chunk.
// The actual vector(768) column is added at runtime by ensureVectorSetup()
// because Prisma does not natively support pgvector's vector type.
// All vector reads/writes use $queryRaw / $executeRaw.
model BirdyEmbedding {
  id         String             @id @default(cuid())
  chunkId    String             @unique
  documentId String
  sessionId  String
  namespace  String             @default("default")
  preview    String             // first 200 chars — for debug/display
  embeddingDim Int              @default(768)
  embeddedAt DateTime           @default(now())
  chunk      BirdyDocumentChunk @relation(fields: [chunkId], references: [id], onDelete: Cascade)
  document   BirdyDocument      @relation(fields: [documentId], references: [id], onDelete: Cascade)
  @@index([sessionId, namespace])
  @@map("birdy_embeddings")
}

// ── Birdy memory ───────────────────────────────────────────────────────────

model BirdyMemorySummary {
  id              String            @id @default(cuid())
  sessionId       String
  conversationId  String
  summary         String            // AI-generated summary of the message range
  messageCount    Int               // how many messages this covers
  fromMessageId   String?
  toMessageId     String?
  model           String?           // which model generated the summary
  createdAt       DateTime          @default(now())
  conversation    BirdyConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  @@index([sessionId, createdAt(sort: Desc)])
  @@index([conversationId])
  @@map("birdy_memory_summaries")
}

// ── Enums ──────────────────────────────────────────────────────────────────

enum RoleStatus   { OPEN ON_HOLD FILLED CLOSED }
enum Priority     { HIGH MEDIUM LOW }
enum Stage        { NEW SCREENING INTERVIEW OFFER HIRED REJECTED ON_HOLD }
enum RoleLinkType { APPLIED CAPABLE }
enum BirdyRole    { USER ASSISTANT }
enum DocumentStatus { PENDING PROCESSING READY ERROR }
