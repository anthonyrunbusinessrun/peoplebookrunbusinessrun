generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Existing models ────────────────────────────────────────────────────────

model Role {
  id             String          @id @default(cuid())
  airtableId     String?         @unique
  title          String
  department     String
  status         RoleStatus      @default(OPEN)
  priority       Priority        @default(MEDIUM)
  employmentType String?
  dateOpened     DateTime?
  dateFilled     DateTime?
  notes          String?
  shift          String?
  hours          String?
  openings       Int             @default(1)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  applicants     ApplicantRole[]

  @@map("roles")
}

model Applicant {
  id                String           @id @default(cuid())
  airtableId        String?          @unique
  fullName          String
  email             String?
  phone             String?
  stage             Stage            @default(NEW)
  cityLocation      String?
  linkedinUrl       String?
  availabilityDate  DateTime?
  salaryExpectation Float?
  source            String?
  yearsExperience   Int?
  highestEducation  String?
  workAuthorization String?
  shiftPreference   String?
  referredBy        String?
  internalRating    String?
  interviewScore    Int?
  applicationScore  Int?
  offerExtended     Boolean          @default(false)
  offerAccepted     Boolean          @default(false)
  doNotContact      Boolean          @default(false)
  interviewDate     DateTime?
  lastContacted     DateTime?
  dateApplied       DateTime?
  notes             String?
  q1                String?
  q2                String?
  q3                String?
  q4                String?
  q5                String?
  q6                String?
  q7                String?
  q8                String?
  q9                String?
  q10               String?
  q11               String?
  q12               String?
  q13               String?
  q14               String?
  q15               String?
  resumeUrl         String?
  resumeName        String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  roles             ApplicantRole[]
  skills            ApplicantSkill[]

  @@map("applicants")
}

model ApplicantRole {
  applicantId String
  roleId      String
  type        RoleLinkType @default(APPLIED)
  applicant   Applicant    @relation(fields: [applicantId], references: [id], onDelete: Cascade)
  role        Role         @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([applicantId, roleId, type])
  @@map("applicant_roles")
}

model Skill {
  id         String           @id @default(cuid())
  airtableId String?          @unique
  name       String           @unique
  category   String?
  notes      String?
  createdAt  DateTime         @default(now())
  applicants ApplicantSkill[]

  @@map("skills")
}

model ApplicantSkill {
  applicantId String
  skillId     String
  applicant   Applicant @relation(fields: [applicantId], references: [id], onDelete: Cascade)
  skill       Skill     @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([applicantId, skillId])
  @@map("applicant_skills")
}

// ── Birdy AI — Core ────────────────────────────────────────────────────────

model BirdyConversation {
  id        String         @id @default(cuid())
  sessionId String
  title     String?
  module    String?        // page context: "home" | "apply" | "admin" | etc.
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  messages  BirdyMessage[]

  @@index([sessionId, updatedAt(sort: Desc)])
  @@map("birdy_conversations")
}

model BirdyMessage {
  id             String            @id @default(cuid())
  conversationId String
  role           BirdyRole
  content        String
  modelUsed      String?
  provider       String?
  tokensIn       Int               @default(0)
  tokensOut      Int               @default(0)
  latencyMs      Int?
  actionKey      String?           // if triggered by a quick action
  createdAt      DateTime          @default(now())
  conversation   BirdyConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt(sort: Asc)])
  @@map("birdy_messages")
}

// ── Birdy AI — Observability ───────────────────────────────────────────────

model BirdyUsageLog {
  id             String   @id @default(cuid())
  sessionId      String
  conversationId String?
  provider       String   // "claude" | "ollama"
  model          String
  intent         String?  // "simple" | "code" | "reasoning" | "strategic"
  tokensIn       Int      @default(0)
  tokensOut      Int      @default(0)
  latencyMs      Int?
  status         String   @default("success")  // "success" | "error" | "fallback"
  errorMessage   String?
  pageModule     String?  // which TeamBase module triggered this
  actionKey      String?  // quick action key if applicable
  createdAt      DateTime @default(now())

  @@index([sessionId, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
  @@map("birdy_usage_logs")
}

// ── Birdy AI — Knowledge Base (RAG-ready) ─────────────────────────────────

model BirdyDocument {
  id          String               @id @default(cuid())
  sessionId   String
  name        String
  mimeType    String
  sizeBytes   Int?
  storageUrl  String               // UploadThing URL
  status      DocumentStatus       @default(PENDING)
  chunkCount  Int                  @default(0)
  errorMsg    String?
  namespace   String               @default("default")
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  chunks      BirdyDocumentChunk[]

  @@index([sessionId, createdAt(sort: Desc)])
  @@map("birdy_documents")
}

model BirdyDocumentChunk {
  id          String        @id @default(cuid())
  documentId  String
  chunkIndex  Int
  content     String
  tokenCount  Int?
  createdAt   DateTime      @default(now())
  document    BirdyDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId, chunkIndex])
  @@map("birdy_document_chunks")
}

// ── Enums ──────────────────────────────────────────────────────────────────

enum RoleStatus {
  OPEN
  ON_HOLD
  FILLED
  CLOSED
}

enum Priority {
  HIGH
  MEDIUM
  LOW
}

enum Stage {
  NEW
  SCREENING
  INTERVIEW
  OFFER
  HIRED
  REJECTED
  ON_HOLD
}

enum RoleLinkType {
  APPLIED
  CAPABLE
}

enum BirdyRole {
  USER
  ASSISTANT
}

enum DocumentStatus {
  PENDING
  PROCESSING
  READY
  ERROR
}
